{
    "name": "shadowbane/laravel-datadog-logger",
    "type": "library",
    "description": "Custom Laravel monolog logger for DataDog logs management via API",
    "keywords": [
        "php",
        "laravel",
        "datadog",
        "log",
        "agent",
        "datadogagent",
        "datadoglog",
        "management",
        "datadog-logger",
        "api",
        "monolog",
        "logger",
        "handler",
        "formatter"
    ],
    "homepage": "https://github.com/shadowbane/laravel-datadog-logger",
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.0 || ^7.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpstan/phpstan": "^1.8"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shadowbane\\DatadogLogger\\Providers\\DataDogServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Shadowbane\\DatadogLogger\\": "src/"
        }
    }
}
